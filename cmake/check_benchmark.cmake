if(NOT DEFINED RESULTS OR NOT EXISTS "${RESULTS}")
    message(FATAL_ERROR "Benchmark JSON does not exist: ${RESULTS}")
endif()
file(READ "${RESULTS}" data)
string(JSON count LENGTH "${data}" benchmarks)
if(count EQUAL 0)
    message(FATAL_ERROR "Benchmark JSON contains no measurements")
endif()
math(EXPR last "${count} - 1")
set(workloads)
foreach(index RANGE 0 ${last})
    string(JSON failed ERROR_VARIABLE missing GET "${data}" benchmarks ${index} error_occurred)
    if(NOT missing AND failed)
        message(FATAL_ERROR "Benchmark reported an error at entry ${index}")
    endif()
    string(JSON run_name GET "${data}" benchmarks ${index} run_name)
    string(JSON run_type GET "${data}" benchmarks ${index} run_type)
    list(APPEND workloads "${run_name}")
    if(run_type STREQUAL "iteration")
        string(JSON iterations GET "${data}" benchmarks ${index} iterations)
        string(JSON real_time GET "${data}" benchmarks ${index} real_time)
        string(JSON cpu_time GET "${data}" benchmarks ${index} cpu_time)
        if(iterations LESS_EQUAL 0 OR real_time LESS_EQUAL 0 OR cpu_time LESS_EQUAL 0)
            message(FATAL_ERROR "Benchmark entry ${index} has no valid timing")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES workloads)
list(LENGTH workloads workload_count)
if(DEFINED EXPECTED_CASES AND NOT workload_count EQUAL EXPECTED_CASES)
    message(FATAL_ERROR "Expected ${EXPECTED_CASES} workloads, got ${workload_count}")
endif()
message(STATUS "Validated ${workload_count} benchmark workloads (${count} JSON entries)")
