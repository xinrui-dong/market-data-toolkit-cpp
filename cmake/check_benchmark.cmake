include("${CMAKE_CURRENT_LIST_DIR}/benchmark_config.cmake")

if(NOT DEFINED RESULTS OR NOT EXISTS "${RESULTS}")
    message(FATAL_ERROR "Benchmark JSON does not exist: ${RESULTS}")
endif()
if(NOT DEFINED EXPECTED_REPETITIONS OR
   NOT EXPECTED_REPETITIONS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "EXPECTED_REPETITIONS must be an explicit positive integer")
endif()

file(READ "${RESULTS}" data)
string(JSON array_type TYPE "${data}" benchmarks)
if(NOT array_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Benchmark measurements must be a JSON array")
endif()
string(JSON count LENGTH "${data}" benchmarks)
if(count EQUAL 0)
    message(FATAL_ERROR "Benchmark JSON contains no measurements")
endif()

# Read from the current entry, requiring actual JSON types rather than strings
# that merely look numeric. Missing members also fail validation.
function(read_member member expected_type output)
    string(JSON member_type ERROR_VARIABLE parse_error TYPE "${entry}" "${member}")
    if(parse_error OR NOT member_type STREQUAL "${expected_type}")
        message(FATAL_ERROR "Benchmark entry ${index}: ${member} must be ${expected_type}")
    endif()
    string(JSON value GET "${entry}" "${member}")
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(require_positive_timing member)
    read_member("${member}" NUMBER timing)
    if(NOT timing MATCHES "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$" OR
       NOT timing GREATER 0 OR timing GREATER 1.7976931348623157e308)
        message(FATAL_ERROR "Benchmark entry ${index}: ${member} must be finite and positive")
    endif()
endfunction()

list(LENGTH COURSE_BENCHMARK_EXPECTED_WORKLOADS workload_count)
math(EXPR final_workload "${workload_count} - 1")
foreach(workload_index RANGE 0 ${final_workload})
    set("seen_${workload_index}")
endforeach()
set(allowed_units ns us ms s)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON entry GET "${data}" benchmarks ${index})
    string(JSON error_type ERROR_VARIABLE missing TYPE "${entry}" error_occurred)
    if(NOT missing)
        read_member(error_occurred BOOLEAN failed)
        if(failed)
            message(FATAL_ERROR "Benchmark reported an error at entry ${index}")
        endif()
    endif()

    read_member(run_name STRING run_name)
    list(FIND COURSE_BENCHMARK_EXPECTED_WORKLOADS "${run_name}" workload_index)
    if(workload_index EQUAL -1)
        message(FATAL_ERROR "Unexpected benchmark workload: ${run_name}")
    endif()
    read_member(repetitions NUMBER declared_repetitions)
    if(NOT declared_repetitions MATCHES "^[1-9][0-9]*$" OR
       NOT declared_repetitions EQUAL EXPECTED_REPETITIONS)
        message(FATAL_ERROR "Benchmark entry ${index}: repetitions does not match EXPECTED_REPETITIONS")
    endif()

    read_member(run_type STRING run_type)
    if(run_type STREQUAL "aggregate")
        continue()
    elseif(NOT run_type STREQUAL "iteration")
        message(FATAL_ERROR "Benchmark entry ${index}: unknown run_type ${run_type}")
    endif()

    read_member(repetition_index NUMBER repetition_index)
    if(NOT repetition_index MATCHES "^(0|[1-9][0-9]*)$" OR
       repetition_index GREATER_EQUAL EXPECTED_REPETITIONS)
        message(FATAL_ERROR "Benchmark entry ${index}: repetition_index is outside the expected range")
    endif()
    list(FIND "seen_${workload_index}" "${repetition_index}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Duplicate repetition_index ${repetition_index} for ${run_name}")
    endif()
    list(APPEND "seen_${workload_index}" "${repetition_index}")

    read_member(iterations NUMBER iterations)
    if(NOT iterations MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "Benchmark entry ${index}: iterations must be a positive integer")
    endif()
    require_positive_timing(real_time)
    require_positive_timing(cpu_time)
    read_member(time_unit STRING time_unit)
    list(FIND allowed_units "${time_unit}" unit_index)
    if(unit_index EQUAL -1)
        message(FATAL_ERROR "Benchmark entry ${index}: unsupported time_unit ${time_unit}")
    endif()
    if(DEFINED benchmark_unit AND NOT "${time_unit}" STREQUAL "${benchmark_unit}")
        message(FATAL_ERROR "Benchmark measurements use inconsistent time units")
    endif()
    set(benchmark_unit "${time_unit}")
endforeach()

foreach(workload_index RANGE 0 ${final_workload})
    list(LENGTH "seen_${workload_index}" repetitions)
    if(NOT repetitions EQUAL EXPECTED_REPETITIONS)
        list(GET COURSE_BENCHMARK_EXPECTED_WORKLOADS ${workload_index} run_name)
        message(FATAL_ERROR "Expected ${EXPECTED_REPETITIONS} measured repetitions for ${run_name}, got ${repetitions}")
    endif()
endforeach()
math(EXPR measurement_count "${workload_count} * ${EXPECTED_REPETITIONS}")
message(STATUS "Validated ${workload_count} exact workloads and ${measurement_count} measured repetitions (${count} JSON entries)")
