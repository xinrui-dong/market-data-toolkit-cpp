PROJECT_NAME           = "Market Data Toolkit"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
INPUT                  = "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/docs" \
                         "@PROJECT_SOURCE_DIR@/third_party/README.md" \
                         "@PROJECT_SOURCE_DIR@/data/README.md"
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/README.md"
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXTRACT_ALL            = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
GENERATE_HTML          = YES
# Static menus avoid missing letter anchors in short member lists in 1.18.0.
HTML_DYNAMIC_MENUS     = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES

HTML_EXTRA_FILES       = "@PROJECT_SOURCE_DIR@/docs/benchmark-20261014.json" \
                         "@PROJECT_SOURCE_DIR@/docs/benchmark-20261016.json"
